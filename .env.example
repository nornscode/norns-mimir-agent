# Core Norns + LLM
# Run `nornsctl dev status` to see the URL and API key — defaults to localhost:4000
NORNS_URL=http://localhost:4000
NORNS_API_KEY=
ANTHROPIC_API_KEY=

# Database (memory storage)
DATABASE_URL=postgresql://mimir_agent:mimir_agent@localhost:5433/mimir_agent

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Slack (optional)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# GitHub (optional)
GITHUB_TOKEN=
# comma-separated owner/repo list
GITHUB_REPOS=

# Figma (optional) — personal access token from https://www.figma.com/settings
# Required to register figma_file sources.
FIGMA_TOKEN=

# The steward (optional) — the daily planning agent. See docs/steward.md.
# Unset STEWARD_SLACK_CHANNEL and the steward bridge stays off entirely.
# Must be the channel ID (C01ABC2DEF3), not the name: Slack reports the ID on
# incoming replies, so a name posts fine and then strands every approval.
STEWARD_SLACK_CHANNEL=
STEWARD_AGENT=norns-steward
STEWARD_MODEL=claude-opus-5
# The agent approved work is handed to. It needs a checkout, so it runs on a
# gard on a real machine, not alongside Mimir.
STEWARD_CODER_AGENT=sleipnir
STEWARD_POLL_SECONDS=20
